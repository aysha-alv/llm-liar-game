# Copy this file to .env and fill in your key:
#   cp .env.example .env

# xAI (Grok) — OpenAI-compatible base URL https://api.x.ai/v1
XAI_API_KEY=your_xai_api_key_here

# OpenAI (optional, for gpt-4o etc.)
# OPENAI_API_KEY=

# Anthropic (optional)
# ANTHROPIC_API_KEY=

# Google Gemini (optional)
# GOOGLE_API_KEY=
# or GEMINI_API_KEY=

# Local Ollama / vLLM (optional) — dummy key often works
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
